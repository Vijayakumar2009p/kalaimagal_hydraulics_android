<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- "Field Visit": shown next to "Document" in Schedule Activity on
         contacts. Assign it to a field staff user; it appears in that
         person's VeeVee Field Locator app, where it is marked done on site. -->
    <record id="activity_type_field_visit" model="mail.activity.type">
        <field name="name">Field Visit</field>
        <field name="summary">Field visit</field>
        <field name="icon">fa-map-marker</field>
        <field name="res_model">res.partner</field>
        <field name="sequence">26</field>
        <field name="delay_count">0</field>
    </record>
</odoo>

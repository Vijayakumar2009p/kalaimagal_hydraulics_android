<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed by the Flutter tool for hot reload and debugging. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Test builds only: allow plain http:// so the app can reach a local
         Odoo (e.g. http://192.168.1.10:8069). Release builds stay https-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
